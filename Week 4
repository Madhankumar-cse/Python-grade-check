import pandas as pd
import matplotlib.pyplot as plt

# Load your dataset
df = pd.read_csv('sales_data (1).csv')

# Display the first 5 rows to confirm it loaded correctly
df.head()

# Group by Region and sum Total_Sales
region_sales = df.groupby('Region')['Total_Sales'].sum().reset_index()

# Display the results
region_sales

# Create a bar chart for sales by region
plt.figure(figsize=(10, 6))
plt.bar(region_sales['Region'], region_sales['Total_Sales'], color='skyblue')

plt.xlabel('Region')
plt.ylabel('Total Sales')
plt.title('Total Sales by Region')
plt.grid(axis='y', linestyle='--', alpha=0.7)
plt.show()
